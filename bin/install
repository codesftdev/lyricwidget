#!/bin/bash
#
# Interactive installer for LyricWidget
# Supports: install, upgrade, and remove
#
# Usage:
#   ./bin/install              (run from within the repo clone)
#   bash <(curl -fsSL ...)     (run directly from GitHub)

# ─── Constants ───────────────────────────────────────────────────────────────

REPO_URL="https://github.com/codesftdev/lyricwidget.git"
PACKAGE_ID="lyricwidget"
PACKAGE_TYPE="Plasma/Applet"
DEFAULT_CLONE_DIR="/tmp/lyricwidget-install"
INSTALLED_DIR="$HOME/.local/share/plasma/plasmoids/$PACKAGE_ID"

# ─── Colors ──────────────────────────────────────────────────────────────────

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# ─── Helpers ─────────────────────────────────────────────────────────────────

die() {
    echo -e "${RED}❌ $1${NC}" >&2
    exit 1
}

warn() {
    echo -e "${YELLOW}⚠️  $1${NC}" >&2
}

info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

success() {
    echo -e "${GREEN}✅ $1${NC}"
}

# Extract version from metadata.json using only grep + sed (no python/jq dep)
get_version_from_json() {
    local file="$1"
    if [ -f "$file" ]; then
        grep '"Version"' "$file" 2>/dev/null | sed 's/.*"Version": "\([^"]*\)".*/\1/'
    else
        echo "unknown"
    fi
}

# ─── Phase 1: Dependency Check ─────────────────────────────────────────────

check_deps() {
    if ! command -v kpackagetool6 &> /dev/null; then
        die "kpackagetool6 not found. Please install KDE Plasma 6 (plasma-sdk or plasma-workspace package)."
    fi

    if ! command -v git &> /dev/null; then
        die "git not found. Please install git."
    fi

    if ! command -v msgfmt &> /dev/null; then
        warn "msgfmt not found (gettext package). Translations will not be compiled."
        return 1
    fi
    return 0
}

# ─── Phase 2: Determine Source Location ──────────────────────────────────────

get_source_dir() {
    local script_dir
    script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

    # Check if we're running from inside the repo
    if [ -f "$script_dir/../src/metadata.json" ]; then
        local repo_root
        repo_root=$(cd "$script_dir/.." && pwd)
        info "Detected existing repo clone — using local source."
        SOURCE_DIR="$repo_root/src"
        SKIP_CLONE=1
        return
    fi

    SKIP_CLONE=0

    local clone_dir
    read -rp "Where should the repo be cloned? [$DEFAULT_CLONE_DIR]: " clone_dir < /dev/tty
    clone_dir=${clone_dir:-$DEFAULT_CLONE_DIR}

    # Handle existing directory
    if [ -d "$clone_dir/.git" ]; then
        local choice
        read -rp "Directory exists and is a git repo. [R]e-clone, [P]ull, or [U]se as-is? [U]: " choice < /dev/tty
        choice=${choice:-U}
        case "$choice" in
            [Rr])
                rm -rf "$clone_dir"
                ;;
            [Pp])
                (cd "$clone_dir" && git pull) || warn "git pull failed, continuing with local copy."
                ;;
            [Uu]|*)
                # Use as-is
                ;;
        esac
    elif [ -d "$clone_dir" ]; then
        if [ -n "$(ls -A "$clone_dir" 2>/dev/null)" ]; then
            die "Directory $clone_dir exists and is not empty. Please choose a different location."
        fi
    fi

    # Clone if needed
    if [ ! -d "$clone_dir/.git" ]; then
        info "Cloning $REPO_URL to $clone_dir..."
        git clone "$REPO_URL" "$clone_dir" || die "Clone failed. Check your network connection."
    fi

    SOURCE_DIR="$clone_dir/src"
}

# ─── Phase 3: Compile Translations ───────────────────────────────────────────

compile_translations() {
    local i18n_script
    i18n_script=$(cd "$SOURCE_DIR/.." && pwd)/bin/i18n

    if [ ! -f "$i18n_script" ]; then
        warn "i18n script not found. Translations will not be compiled."
        return
    fi

    info "Compiling translations..."
    if bash "$i18n_script" compile; then
        success "Translations compiled."
    else
        warn "Translation compilation failed, but continuing..."
    fi
}

# ─── Phase 4: Install / Upgrade / Remove ─────────────────────────────────────

is_installed() {
    [ -d "$INSTALLED_DIR" ]
}

get_installed_version() {
    get_version_from_json "$INSTALLED_DIR/metadata.json"
}

get_source_version() {
    get_version_from_json "$SOURCE_DIR/metadata.json"
}

do_install() {
    if is_installed; then
        info "LyricWidget is already installed (version $(get_installed_version))."
        local choice
        read -rp "Would you like to upgrade instead? [Y/n]: " choice < /dev/tty
        choice=${choice:-Y}
        if [[ "$choice" =~ ^[Yy] ]]; then
            do_upgrade
        else
            info "Skipping install."
        fi
        return
    fi

    info "Installing LyricWidget..."
    if kpackagetool6 -i "$SOURCE_DIR" --type "$PACKAGE_TYPE"; then
        success "LyricWidget installed successfully!"
        ask_restart_after_change "install"
    else
        die "Installation failed."
    fi
}

do_upgrade() {
    if ! is_installed; then
        info "LyricWidget is not currently installed."
        local choice
        read -rp "Would you like to install it instead? [Y/n]: " choice < /dev/tty
        choice=${choice:-Y}
        if [[ "$choice" =~ ^[Yy] ]]; then
            do_install
        else
            info "Skipping upgrade."
        fi
        return
    fi

    info "Upgrading LyricWidget..."
    if kpackagetool6 -u "$SOURCE_DIR" --type "$PACKAGE_TYPE"; then
        success "LyricWidget upgraded successfully!"
        ask_restart_after_change "upgrade"
    else
        die "Upgrade failed."
    fi
}

do_remove() {
    if ! is_installed; then
        warn "LyricWidget is not currently installed."
        return
    fi

    local choice
    read -rp "Are you sure you want to remove LyricWidget? [y/N]: " choice < /dev/tty
    if [[ "$choice" =~ ^[Yy] ]]; then
        info "Removing LyricWidget..."
        if kpackagetool6 -r "$PACKAGE_ID" --type "$PACKAGE_TYPE"; then
            success "LyricWidget removed successfully!"
        else
            die "Removal failed."
        fi
    else
        info "Skipping removal."
    fi
}

do_restart_plasma() {
    if ! command -v plasmashell &> /dev/null; then
        die "plasmashell not found. Cannot restart Plasma."
    fi

    local choice
    read -rp "This will briefly restart your Plasma desktop. Continue? [Y/n]: " choice < /dev/tty
    choice=${choice:-Y}
    if [[ "$choice" =~ ^[Yy] ]]; then
        info "Restarting KDE Plasma..."
        plasmashell --replace &
        success "Plasma restarted."
    else
        info "Skipping restart."
    fi
}

ask_restart_after_change() {
    local action="$1"
    local choice
    read -rp "Restart KDE Plasma to apply $action changes? [Y/n]: " choice < /dev/tty
    choice=${choice:-Y}
    if [[ "$choice" =~ ^[Yy] ]]; then
        do_restart_plasma
    fi
}

# ─── Phase 5: Cleanup ────────────────────────────────────────────────────────

cleanup() {
    if [ "$SKIP_CLONE" -eq 1 ]; then
        return
    fi

    local clone_dir
    clone_dir=$(cd "$SOURCE_DIR/.." && pwd)

    local choice
    read -rp "Delete the cloned repo at $clone_dir? [y/N]: " choice < /dev/tty
    if [[ "$choice" =~ ^[Yy] ]]; then
        rm -rf "$clone_dir"
        success "Clone directory removed."
    fi
}

# ─── Phase 6: Menu ───────────────────────────────────────────────────────────

show_menu() {
    local src_ver installed_ver status_line
    src_ver=$(get_source_version)
    installed_ver=$(get_installed_version)

    if is_installed; then
        status_line="Installed: v$installed_ver"
    else
        status_line="Status:  Not installed"
    fi

    echo ""
    echo -e "${BLUE}╔══════════════════════════════╗${NC}"
    echo -e "${BLUE}║      LyricWidget Setup       ║${NC}"
    echo -e "${BLUE}╠══════════════════════════════╣${NC}"
    printf  "${BLUE}║  Source:    v%-14s ║${NC}\n" "$src_ver"
    printf  "${BLUE}║  %-26s ║${NC}\n" "$status_line"
    echo -e "${BLUE}╠══════════════════════════════╣${NC}"
    echo -e "${BLUE}║  1) Install / Upgrade        ║${NC}"
    echo -e "${BLUE}║  2) Remove / Uninstall       ║${NC}"
    echo -e "${BLUE}║  3) Restart Plasma           ║${NC}"
    echo -e "${BLUE}║  4) Quit                     ║${NC}"
    echo -e "${BLUE}╚══════════════════════════════╝${NC}"
    echo ""
}

# ─── Main ────────────────────────────────────────────────────────────────────

check_deps
get_source_dir
compile_translations

while true; do
    show_menu
    read -rp "Enter choice [1-4]: " choice < /dev/tty

    case "$choice" in
        1)
            if is_installed; then
                do_upgrade
            else
                do_install
            fi
            ;;
        2)
            do_remove
            ;;
        3)
            do_restart_plasma
            ;;
        4|q|Q|quit|exit)
            info "Exiting."
            break
            ;;
        *)
            warn "Invalid choice. Please enter 1, 2, 3, or 4."
            ;;
    esac
done

cleanup
